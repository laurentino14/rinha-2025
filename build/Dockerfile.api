FROM golang:1.24.4-alpine AS prepare
RUN apk update && apk add --no-cache czmq-dev gcc musl-dev

FROM prepare AS build
WORKDIR /usr/src/api

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=1 go build -o main cmd/api/main.go

FROM alpine:latest AS prepare-runner

RUN apk update && apk add --no-cache czmq && rm -rf /var/cache/apk/*

FROM prepare-runner AS runner
WORKDIR /app
COPY --from=build /usr/src/api/main .

CMD ["./main"]
